rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /price_reports/{reportId} {
      // Anyone can read crowd price reports
      allow read: if true;
      
      // Creating a report requires authentication, and author must be the signed-in user
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.crop is string
                    && request.resource.data.nodeId is int;
                    
      // Users can only edit or delete their own reports
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
