<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp"
    app:strokeColor="#DEE8DF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Circular Rank Badge -->
        <TextView
            android:id="@+id/textRank"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge_rank_n"
            android:gravity="center"
            android:textColor="@color/pri"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Market Info & Tags -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#142C1B"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    tools:text="Dhaka" />

                <!-- Badge -->
                <TextView
                    android:id="@+id/textTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tag_best"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/white"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="BEST"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/textRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="11sp"
                tools:text="📍 270 km · 4 h 10 min" />

            <TextView
                android:id="@+id/textPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Price ৳35.5/kg" />

            <TextView
                android:id="@+id/textCosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Transport ৳1,200 · Toll ৳0 · Spoilage 3.5%" />
        </LinearLayout>

        <!-- Net Profit -->
        <TextView
            android:id="@+id/textProfit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#166534"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="৳42.50" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
