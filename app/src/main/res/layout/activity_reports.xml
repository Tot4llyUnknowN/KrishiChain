<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Status Bar (.sb) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9:41"
            android:textColor="@color/mut"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_online"
            android:textColor="@color/pri"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Header (.hd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="10dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="64 District Market Prices"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Body (.bd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Selected Crop Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_farmer_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/textCropHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥔 Showing Prices for Potato (64 Market Hubs)"
                android:textColor="#144623"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textChangeCropHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Crop"
                android:textColor="#52705D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tabs (.tb) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabLatestPrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tab_on"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:text="@string/latest_prices"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPriceAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_off"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:text="@string/price_alerts"
                android:textColor="@color/ink"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Price Reports Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReports"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_price_report" />

        <!-- Price Alert Card (.cd style="background:#ffebee;color:#8a1c1c;font-size:11px") -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPriceAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/alert_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFCDD2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_title"
                    android:textColor="@color/alert_card_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAlertContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Potato average up 5.2%"
                    android:textColor="@color/alert_card_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sort Control Row: Sort by Price vs Sort by District -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSortPrice"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Sort by Price (High → Low)"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSortDistrict"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Sort by District (A → Z)"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Big Amber Report Price Button (.bt .a) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubmitPrice"
            style="@style/Widget.KrishiChain.Button.Amber"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/report_price_btn"
            android:textSize="13sp" />

        <!-- Hidden compat views -->
        <TextView
            android:id="@+id/textAuthUser"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonManageAuth"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApplyToDb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressReports"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
