<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <include layout="@layout/layout_top_status_bar" />

    <!-- Header matching homepage theme -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/route_title"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="KrishiChain Leaf"
            android:src="@drawable/ic_leaf_logo"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Scrollable Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. Summary Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KrishiChain.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/textRouteTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#142C1B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Dumuria → Shyambazar Market" />

                    <TextView
                        android:id="@+id/textRouteMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        tools:text="Distance 270 km · Time 4 h 10 min" />

                    <TextView
                        android:id="@+id/textProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/pri"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Net profit ৳ 35,649" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Cheapest vs Fastest Tabs -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabCheapest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tab_on"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/route_cheapest"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFastest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/route_fastest"
                    android:textColor="#143E23"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hidden radio group for backwards-compatibility -->
            <RadioGroup
                android:id="@+id/radioMode"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">
                <RadioButton android:id="@+id/radioCheapest" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <RadioButton android:id="@+id/radioFastest" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </RadioGroup>

            <!-- 3. OpenStreetMap Live Interactive Route Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KrishiChain.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- OSM Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EDF6EE"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="OpenStreetMap Live Route"
                            android:textColor="#143E23"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_white"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="OSM Tiles"
                            android:textColor="#1B7A2F"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Interactive OSM WebView -->
                    <WebView
                        android:id="@+id/mapWebView"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />

                    <!-- Fallback/Legacy Linear View -->
                    <com.kuet.krishichain.ui.LinearRouteView
                        android:id="@+id/linearRouteView"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Progress -->
            <ProgressBar
                android:id="@+id/progress"
                style="@style/Widget.Material3.CircularProgressIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="16dp"
                android:indeterminateTint="@color/pri"
                android:visibility="gone" />

            <!-- 4. Waypoints / Turn-by-Turn Steps Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KrishiChain.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Turn-by-Turn Waypoints"
                            android:textColor="#142C1B"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textWaypointsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_white"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Shortest Path"
                            android:textColor="#1B7A2F"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_step" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Start Navigation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStartNavigation"
                style="@style/Widget.KrishiChain.Button.Green"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="🚀 Start Turn-by-Turn Navigation"
                android:textSize="13.5sp" />

            <!-- 6. Secondary Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonShare"
                    style="@style/Widget.KrishiChain.Button.OutlinedControl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/button_share"
                    android:textSize="11.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonMap"
                    style="@style/Widget.KrishiChain.Button.OutlinedControl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:text="@string/button_map"
                    android:textSize="11.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCall"
                    style="@style/Widget.KrishiChain.Button.OutlinedControl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/button_call"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
