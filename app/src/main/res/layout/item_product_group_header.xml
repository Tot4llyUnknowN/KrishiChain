<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:paddingHorizontal="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#EAF4EC"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#C5DEC9"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/textGroupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥔 Potato Prices"
                android:textColor="#144623"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textGroupCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_ok"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="64 District Hubs"
                android:textColor="#1E652E"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
