<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <include layout="@layout/layout_top_status_bar" />

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="64 Market Hubs &amp; Road Network"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real highway corridors &amp; shortest paths"
                android:textColor="#C8E6C9"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="KrishiChain Leaf"
            android:src="@drawable/ic_leaf_logo"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Origin & Crop Selection Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EDF6EE"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Origin Selector -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 My Location (Origin)"
                    android:textColor="#144623"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_spinner_dropdown"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>

            <!-- Crop Selector -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 Crop"
                    android:textColor="#144623"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_spinner_dropdown"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Destination Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏁 Destination:"
                android:textColor="#144623"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerDest"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_dropdown"
                android:paddingHorizontal="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Map Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Interactive OpenStreetMap 64 Zillas WebView -->
        <WebView
            android:id="@+id/mapWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/mapProgress"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pri"
            android:visibility="gone" />

        <!-- Destination Selection & Shortest Path Sheet Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectedHub"
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:elevation="6dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Hub Name & Price Tag -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textSelectedHubTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select any District Hub"
                        android:textColor="#142C1B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSelectedHubPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Tap any pin"
                        android:textColor="#1B7A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Optimal Shortest Path Via Districts -->
                <TextView
                    android:id="@+id/textOptimalRouteNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Tap any of the 64 district pins to view shortest path &amp; visited districts"
                    android:textColor="#475569"
                    android:textSize="11.5sp" />

                <!-- Meta Row: Distance, Travel Time, Est. Profit -->
                <LinearLayout
                    android:id="@+id/layoutMetaRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textMetaDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 0 km"
                        android:textColor="#1B7A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textMetaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="⏱ 0 hr"
                        android:textColor="#334155"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textMetaProfit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Profit ৳ 0"
                        android:textColor="#047857"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- View Route Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonViewRouteDetails"
                    style="@style/Widget.KrishiChain.Button.Green"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="View Turn-by-Turn Route →"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Universal Bottom Navigation Bar (Map active) -->
    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
