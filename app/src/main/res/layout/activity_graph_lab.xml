<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Header (.hd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/lab_title"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="KrishiChain Leaf"
            android:src="@drawable/ic_leaf_logo"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Body (.bd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Tabs (.tb) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabDijkstra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_tab_on"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Dijkstra"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabBellman"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_tab_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Bellman-Ford"
                    android:textColor="@color/ink"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tabFloyd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_tab_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Floyd"
                    android:textColor="@color/ink"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tabJohnson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Johnson"
                    android:textColor="@color/ink"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Light Canvas Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_canvas"
            android:padding="4dp">

            <com.kuet.krishichain.ui.GraphView
                android:id="@+id/graphView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Checklist Items (.ck) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="vertical">

            <!-- Check 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/bg_check_circle"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCheck1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Running Dijkstra…"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Check 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/bg_check_circle"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCheck2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Shortest path: Khulna → Dhaka"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Check 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/bg_check_circle"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCheck3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Cost: 4"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speed Row (.row .mut) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed"
                android:textColor="@color/mut"
                android:textSize="10.5sp" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="65"
                android:progressTint="@color/pri"
                android:thumbTint="@color/pri" />
        </LinearLayout>

        <!-- Run Again Button (.bt) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRun"
            style="@style/Widget.KrishiChain.Button.Green"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/button_run"
            android:textSize="13sp" />

        <!-- Optional subtle controls bar (Step / Play) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlay"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_play"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStep"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_step"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEnd"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_end"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Hidden / Compatibility Spinners -->
        <Spinner
            android:id="@+id/spinnerAlgo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerSource"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerDest"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
