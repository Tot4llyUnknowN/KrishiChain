<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <include layout="@layout/layout_top_status_bar" />

    <!-- Header (.hd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="10dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Road Bottleneck &amp; Capacity Analyzer"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Body (.bd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Origin / Supply Hub Selector Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCluster"
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Origin / Supply Hub:"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner_dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteCluster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:completionThreshold="1"
                        android:dropDownHeight="260dp"
                        android:gravity="center_vertical"
                        android:hint="Type or select district"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:paddingStart="8dp"
                        android:paddingEnd="26dp"
                        android:singleLine="true"
                        android:textColor="#144623"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Network Flow Graph View Container -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1">

            <com.kuet.krishichain.ui.GraphView
                android:id="@+id/graphView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Max Flow Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            app:cardBackgroundColor="@color/pri2"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textFlowInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="@color/pri"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Max Freight Flow: 280 tons/day" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Min-Cut Edges Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bottleneck Highway Corridors (Minimum Cut):"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/mut"
                    android:textSize="11sp"
                    tools:text="Tangail → Gazipur (100/100, full)\nSirajganj → Tangail (100/100, full)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Legend / Note -->
        <TextView
            android:id="@+id/textAssumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Cyan = Freight flow · Thick Red = Saturated bottleneck road · Computes highway capacity using Edmonds-Karp Max-Flow Min-Cut."
            android:textColor="@color/mut"
            android:textSize="10.5sp" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRun"
                style="@style/Widget.KrishiChain.Button.Green"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="2"
                android:text="Analyze Flow"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlay"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_play"
                android:textSize="10.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStep"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_step"
                android:textSize="10.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEnd"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_end"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
