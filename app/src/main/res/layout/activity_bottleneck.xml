<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Status Bar (.sb) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9:41"
            android:textColor="@color/mut"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_online"
            android:textColor="@color/pri"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Header (.hd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="10dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bn_title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Body (.bd) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Farmer Cluster Card (.cd .row) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCluster"
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bn_cluster"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textClusterDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bn_all"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spinnerCluster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Network Flow Graph View Container -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1">

            <com.kuet.krishichain.ui.GraphView
                android:id="@+id/graphView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Max Flow Card (.cd style="background:var(pri2);font-size:15px;font-weight:800;color:var(pri)") -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            app:cardBackgroundColor="@color/pri2"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textFlowInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="@color/pri"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Max flow: 180 t/day" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Min-Cut Edges Card (.cd) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bn_cut_header"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/mut"
                    android:textSize="11sp"
                    tools:text="Magura → Faridpur (60/60, full)\nKhulna → Bagerhat (60/60, full)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Assumption Note (.mut) -->
        <TextView
            android:id="@+id/textAssumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/bn_assume"
            android:textColor="@color/mut"
            android:textSize="10.5sp" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRun"
                style="@style/Widget.KrishiChain.Button.Green"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="2"
                android:text="Analyze Flow"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlay"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_play"
                android:textSize="10.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStep"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_step"
                android:textSize="10.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEnd"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="@string/button_end"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
