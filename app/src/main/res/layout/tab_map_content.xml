<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="64 Market Hubs &amp; Road Network"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real highway corridors &amp; shortest paths"
                android:textColor="#C8E6C9"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="KrishiChain Leaf"
            android:src="@drawable/ic_leaf_logo"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Origin & Crop Selection Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EDF6EE"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Origin and Destination Search Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Origin Selector: AutoComplete Searchable -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From Origin:"
                    android:textColor="#2D4A3E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_spinner_dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:completionThreshold="1"
                        android:dropDownHeight="260dp"
                        android:gravity="center_vertical"
                        android:hint="Type or select origin"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:paddingStart="8dp"
                        android:paddingEnd="26dp"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textColor="#144623"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Destination Selector: AutoComplete Searchable -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To Destination:"
                    android:textColor="#2D4A3E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_spinner_dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteDest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:completionThreshold="1"
                        android:dropDownHeight="260dp"
                        android:gravity="center_vertical"
                        android:hint="Tap pin or type dest"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:paddingStart="8dp"
                        android:paddingEnd="26dp"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textColor="#144623"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Crop selection row & Reset Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product:"
                android:textColor="#2D4A3E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_dropdown">

                <Spinner
                    android:id="@+id/spinnerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingEnd="24dp" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonResetView"
                style="@style/Widget.KrishiChain.Button.OutlinedControl"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:text="Reset Map"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map View Container with Interactive Webview & Overlay Bottom Sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/mapWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Selected Route Info Card (Floating bottom sheet) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRouteSummary"
            style="@style/Widget.KrishiChain.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header: Destination and Wholesale Price -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textSelectedHubTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select a Destination Market"
                        android:textColor="#111827"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSelectedHubRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Tap any pin"
                        android:textColor="#1B7A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Optimal Shortest Path Via Districts -->
                <TextView
                    android:id="@+id/textOptimalRouteNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Tap any of the 64 district pins to view shortest path &amp; visited districts"
                    android:textColor="#475569"
                    android:textSize="11.5sp" />

                <!-- Meta Row: Distance, Travel Time, Est. Profit -->
                <LinearLayout
                    android:id="@+id/layoutMetaRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textMetaDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 0 km"
                        android:textColor="#1B7A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textMetaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="⏱ 0 hr"
                        android:textColor="#334155"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textMetaProfit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Profit ৳ 0"
                        android:textColor="#047857"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- View Route Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonViewRouteDetails"
                    style="@style/Widget.KrishiChain.Button.Green"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="View Turn-by-Turn Route →"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</LinearLayout>
