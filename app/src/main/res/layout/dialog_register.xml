<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Container 1: Registration Form -->
    <LinearLayout
        android:id="@+id/layoutRegisterForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Create a new account with your email and password"
            android:textColor="@color/mut"
            android:textSize="13sp" />

        <!-- Email Address Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Email Address"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/pri">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Password (min 6 characters)"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/pri"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRegister"
            style="@style/Widget.KrishiChain.Button.Green"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Register"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Container 2: Email Verification Box -->
    <LinearLayout
        android:id="@+id/layoutVerificationBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Your Email"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVerificationNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:text="A verification link has been sent to your email. Click the link in your email, then tap Verified via Link below:"
            android:textColor="@color/mut"
            android:textSize="13sp" />

        <!-- Verified via Link Button Container with Circular Loading Spinner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVerifyLink"
                style="@style/Widget.KrishiChain.Button.OutlinedGreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Verified via Link"
                android:textColor="@color/splash_motto"
                android:textSize="14sp"
                app:strokeColor="@color/splash_motto" />

            <ProgressBar
                android:id="@+id/progressVerifying"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/splash_motto"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Resend Email -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResendCode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resend verification email"
            android:textColor="@color/pri"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
