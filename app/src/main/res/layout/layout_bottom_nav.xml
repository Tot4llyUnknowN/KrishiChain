<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <!-- 1: Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Home Tab"
            android:src="@drawable/ic_nav_home"
            app:tint="#6B7F72" />

        <TextView
            android:id="@+id/textHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Home"
            android:textColor="#6B7F72"
            android:textSize="10sp" />

        <View
            android:id="@+id/indicatorHome"
            android:layout_width="18dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 2: Prices -->
    <LinearLayout
        android:id="@+id/navPrices"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconPrices"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Prices Tab"
            android:src="@drawable/ic_nav_prices"
            app:tint="#6B7F72" />

        <TextView
            android:id="@+id/textPrices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Prices"
            android:textColor="#6B7F72"
            android:textSize="10sp" />

        <View
            android:id="@+id/indicatorPrices"
            android:layout_width="18dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 3: Map (64 Zillas) -->
    <LinearLayout
        android:id="@+id/navMap"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconMap"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Map Tab"
            android:src="@drawable/ic_nav_map"
            app:tint="#6B7F72" />

        <TextView
            android:id="@+id/textMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Map"
            android:textColor="#6B7F72"
            android:textSize="10sp" />

        <View
            android:id="@+id/indicatorMap"
            android:layout_width="18dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 3: More -->
    <LinearLayout
        android:id="@+id/navMore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconMore"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="More Tab"
            android:src="@drawable/ic_nav_more"
            app:tint="#6B7F72" />

        <TextView
            android:id="@+id/textMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="More"
            android:textColor="#6B7F72"
            android:textSize="10sp" />

        <View
            android:id="@+id/indicatorMore"
            android:layout_width="18dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
