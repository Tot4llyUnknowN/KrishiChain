<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Header matching homepage theme -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/pri"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ranking_title"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="KrishiChain Leaf"
            android:src="@drawable/ic_leaf_logo"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Market Highlighted Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopMarket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/home_mint_tile"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="#DBEADE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/top_market_sort"
                    android:textColor="#52705D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTopMarketName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#142C1B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="🏅 Dhaka" />

                <TextView
                    android:id="@+id/textTopMarketProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#1B7A2F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Net profit ৳ 42.50/kg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Spinner -->
        <ProgressBar
            android:id="@+id/progress"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="16dp"
            android:indeterminateTint="@color/pri" />

        <!-- Ranked Markets Recycler with white list styling -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/home_bg"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_market" />

        <!-- Sort By Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sort_by"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_ok"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/sort_net_profit"
                android:textColor="@color/badge_ok_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- View Details Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonViewDetails"
            style="@style/Widget.KrishiChain.Button.Green"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/view_details"
            android:textSize="13.5sp" />

        <!-- Hidden / Optional Insight text -->
        <TextView
            android:id="@+id/textInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/mut"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textDemoWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
